BOT_TOKEN=
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
# запасная модель: если основная недоступна (сеть, перегрузка, ошибка провайдера)
LLM_FALLBACK_MODEL=x-ai/grok-4.3
# голосовые и фото: модель, понимающая аудио и картинки
MEDIA_MODEL=google/gemini-3.5-flash-lite
# голосовые: local — Whisper на этом компьютере (бесплатно), openrouter — через MEDIA_MODEL
STT_BACKEND=local
# размер Whisper: tiny / base / small / medium (точнее, но медленнее)
WHISPER_MODEL=base
# Telegram user_id руководителей через запятую. Пусто = первый, кто напишет /start боту, станет руководителем
MANAGER_IDS=
DB_PATH=bot.db
TIMEZONE_OFFSET=3
DIGEST_HOUR=9
# Mini App: публичный HTTPS-адрес (пусто — кнопка в личке не ставится) и где слушает веб-сервер
WEBAPP_URL=
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
# только для локальной отладки в браузере без Telegram: user_id, от имени которого открывать
WEBAPP_DEV_USER=
